# Copy this file to .env on the Docker host. Do not commit the populated .env.

# Existing persistent NFS exports. Keep these pointed at the current data.
NFS_SERVER=172.16.16.29
NFS_VERSION=3
NFS_DATA_EXPORT=/mnt/vol1/gpudata/lugezg/jrbonill/data
NFS_ROOT_EXPORT=/mnt/vol1/gpudata/lugezg/jrbonill/root

# The two host A100 device indexes assigned to this container.
GPU_DEVICE_0=0
GPU_DEVICE_1=1

# CUDA OpenCV source-build parallelism.
OPENCV_BUILD_JOBS=8

# Key-only SSH. Put the complete public key in single quotes.
SSH_BIND_ADDRESS=0.0.0.0
SSH_HOST_PORT=31092
SSH_PUBLIC_KEY=''

# Jupyter and TensorBoard remain host-local; access them through SSH tunnels.
JUPYTER_BIND_ADDRESS=127.0.0.1
JUPYTER_HOST_PORT=8888
JUPYTER_TOKEN=
TENSORBOARD_BIND_ADDRESS=127.0.0.1
TENSORBOARD_HOST_PORT=6006
